# Copy to /opt/geo-app/.env on the server and fill in every value.
# Keep this file only on the server (chmod 600). Never commit the real one.

# ---- Domains (point both DNS A records at the server's IP first) ----
LANDING_DOMAIN=geo.example.in
ADMIN_DOMAIN=admin.example.in
# Let's Encrypt sends certificate expiry notices here
ACME_EMAIL=you@example.in
# Only these IPs can open the admin panel (space-separated). Find yours at https://ifconfig.me
# Use "0.0.0.0/0 ::/0" to allow everyone (not recommended).
ADMIN_ALLOWED_IPS=203.0.113.10 198.51.100.25

# ---- Database (generate long random passwords: openssl rand -hex 24) ----
DB_NAME=geo_optional
DB_USER=app
DB_PASSWORD=
MYSQL_ROOT_PASSWORD=

# ---- Razorpay (live keys once KYC is approved; test keys before that) ----
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ---- Programme ----
COURSE_FEE_INR=7355
COURSE_NAME=Geography (Optional) 500+ Video Programme

# ---- Admin login tokens (openssl rand -hex 48) ----
JWT_SECRET=
JWT_EXPIRES_IN=8h

# ---- Cloudflare Turnstile CAPTCHA (dash.cloudflare.com → Turnstile) ----
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ---- Set by the deploy pipeline; you don't need to change these ----
GHCR_OWNER=sud-sharma
IMAGE_TAG=latest
