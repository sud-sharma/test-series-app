# Server
PORT=4000
NODE_ENV=development

# Comma-separated list of origins allowed to call the API
# (your landing page + the admin panel)
CORS_ORIGINS=http://localhost:5173,http://localhost:8080

# MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=geo_optional

# Razorpay (Dashboard → Account & Settings → API Keys)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
# Dashboard → Webhooks → secret you set for the webhook
RAZORPAY_WEBHOOK_SECRET=change_me

# Programme fee in rupees INCLUDING GST (the amount is always taken from here, never
# from the browser). 7355 = 2500 + 125 GST (study materials) + 4000 + 730 GST (videos)
COURSE_FEE_INR=7355
COURSE_NAME="Geography (Optional) 500+ Video Programme"

# Admin auth (in production the server refuses to start with a short or default secret)
JWT_SECRET=replace_with_a_long_random_string
JWT_EXPIRES_IN=8h

# ---- Security ----
# Number of reverse proxies in front of the API so rate limits see the real visitor IP.
# Local development: 0. Behind nginx: 1. Never set higher than the real number of proxies.
TRUST_PROXY=0

# Cloudflare Turnstile CAPTCHA (free): dash.cloudflare.com → Turnstile → Add widget.
# Leave both empty to switch the CAPTCHA off (fine for local development).
# Test keys that always pass: site 1x00000000000000000000AA / secret 1x0000000000000000000000000000000AA
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Comma-separated hostnames the landing page is served from (tokens from other sites are rejected)
TURNSTILE_HOSTNAMES=
