# Server
PORT=4000
NODE_ENV=development

# Comma-separated list of origins allowed to call the API
# (your landing page + the admin panel)
CORS_ORIGINS=http://localhost:5173,http://localhost:8080

# MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=test_series

# Razorpay (Dashboard → Account & Settings → API Keys)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
# Dashboard → Webhooks → secret you set for the webhook
RAZORPAY_WEBHOOK_SECRET=change_me

# Course fee in rupees (the amount is always taken from here, never from the browser)
COURSE_FEE_INR=4999
COURSE_NAME=Test Series 2026

# Admin auth
JWT_SECRET=replace_with_a_long_random_string
JWT_EXPIRES_IN=8h
